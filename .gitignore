# Augmented chunks (P1.3 - regenerate via build_augmented_chunks.py)
dataset/aug_chunk/
dataset/features_aug.h5
dataset/features_mixed_aug.h5

# Run logs (regenerate via the matching script)
results/transfer_learn.log
results/hpo.log
results/vision_train.log

# Mid-sweep ablation output directories (regenerate via the matching

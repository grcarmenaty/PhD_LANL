# Large raw data files (too big for GitHub)
experimental_frfs.h5
raw_frfs.npz

# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/

# Jupyter
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db
test_write.tmp
*.swp
*~

# Allow chunked splits
!experimental_frfs_chunks/
!experimental_frfs_chunks/**

# Derived ML-pipeline artefacts (regenerate with the scripts)
dataset/features.h5
dataset/experimental_features.h5
dataset/features_balanced.h5
dataset/experimental_features_balanced.h5
experimental_frfs.h5
results/train.log
results/hpo.log

# Large RF / XGB pickles regenerate with train.py; keep small Torch .pt only.
results/models/*.pkl
results/models_indicators/*.pkl

# Per-case eval blobs — regenerate with evaluate_full_experimental.py
results/experimental_full_per_case.json
results/balanced/experimental_full_per_case.json


# Noisy-mixed pipeline outputs (regeneratable)
results/noisy_mixed/balanced/experimental_full_per_case.json
results/noisy_mixed/models/*.pkl
results/noisy_mixed/models_indicators/*.pkl

# Sweep launcher logs (kept locally only)
logs/

# Mixed-training VDS pointer file (regenerate via build_mixed_features.py)
dataset/features_mixed.h5

# v2/v2a synthetic-physics derived data (regenerate via variation_v2.py / build_features.py)
dataset/features_v2.h5
dataset/features_v2a.h5
dataset_v2/
dataset_v2a/

# Per-seed training output directories (~87 MB each, regenerate via train.py + evaluate_full_experimental.py)
results_seed*/
results_v1_seed*/
results_v2_seed*/
results_v2a_seed*/

# Scratch per-case eval blobs from one-off experiments (regenerate via evaluate_full_experimental.py)
results/experimental_full_per_case_aug.json
results/experimental_full_per_case_basescore.json
results/experimental_full_per_case_plain.json

# Hires CFDAC preliminary derived data (regenerable from chunks)
dataset_hires/
dataset/features_hires.h5
dataset/experimental_features_hires.h5

# transient hires sweep runner stdout
results_hires/sweep.nohup
